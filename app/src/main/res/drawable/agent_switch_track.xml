<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/color_teal_tint" />
            <stroke android:width="1dp" android:color="@color/color_teal_border" />
            <corners android:radius="999dp" />
            <size android:height="23dp" android:width="40dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_bg_light" />
            <stroke android:width="1dp" android:color="@color/color_border" />
            <corners android:radius="999dp" />
            <size android:height="23dp" android:width="40dp" />
        </shape>
    </item>
</selector>